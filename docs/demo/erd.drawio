        <UserObject id="n|solidus.public.spree_store_credit_events" label="&lt;span style=&quot;font-kerning: none; font-variant-ligatures: none; font-feature-settings: 'kern' 0, 'liga' 0, 'calt' 0;&quot;&gt;&lt;img src=&quot;data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxNCIgaGVpZ2h0PSIxNCIgdmlld0JveD0iMCAwIDE0IDE0Ij48cGF0aCBmaWxsPSJub25lIiBzdHJva2U9IiM1ZjZiN2UiIHN0cm9rZS13aWR0aD0iMS4xIiBkPSJNMiAzSDEyVjExSDJaTTIgNS41SDEyTTYgNS41VjExIi8+PC9zdmc+&quot; width=&quot;12&quot; height=&quot;12&quot; style=&quot;vertical-align:middle;margin-right:3px&quot;&gt;spree_store_credit_events&lt;/span&gt;" table="solidus.public.spree_store_credit_events" domain="Store Credit" description="Ledger of actions on a store credit (allocate, authorize, capture, void, credit) with running totals." central="no" indexes="index_spree_store_credit_events_on_deleted_at: deleted_at&#10;index_spree_store_credit_events_on_store_credit_id: store_credit_id" note="&lt;p style=&quot;margin:0 0 4px&quot;&gt;&lt;b&gt;solidus.public.spree_store_credit_events&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 0 2px&quot;&gt;Ledger of actions on a store credit (allocate, authorize, capture, void, credit) with running totals.&lt;/p&gt;&lt;table cellpadding=&quot;2&quot; style=&quot;border-collapse:collapse;width:100%;overflow-wrap:anywhere;font-size:11px;margin-top:6px&quot;&gt;&lt;tr align=&quot;left&quot; style=&quot;color:#7a8597;white-space:nowrap&quot;&gt;&lt;th&gt;Column&lt;/th&gt;&lt;th&gt;Type&lt;/th&gt;&lt;th&gt;Null&lt;/th&gt;&lt;th&gt;Default&lt;/th&gt;&lt;th&gt;Comment&lt;/th&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#c98a04;font-size:9px;font-weight:bold&quot;&gt;PK&lt;/span&gt; &lt;b&gt;id&lt;/b&gt;&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Surrogate key.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; &lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; store_credit_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;no&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;References the store credit.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#7c5cc4;font-size:9px;font-weight:bold&quot;&gt;ENUM&lt;/span&gt; action&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;no&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Ledger action performed.&lt;br&gt;allocation — Credit granted&lt;br&gt;authorize — Amount reserved for a payment&lt;br&gt;capture — Reserved amount taken&lt;br&gt;void — Authorization released&lt;br&gt;credit — Amount given back after refund&lt;br&gt;eligible — Eligibility check&lt;br&gt;adjustment — Admin changed the amount&lt;br&gt;invalidate — Credit invalidated&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;amount&lt;/td&gt;&lt;td nowrap&gt;decimal(8,2)&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Monetary amount.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;user_total_amount&lt;/td&gt;&lt;td nowrap&gt;decimal(8,2)&lt;/td&gt;&lt;td nowrap&gt;no&lt;/td&gt;&lt;td nowrap&gt;0.0&lt;/td&gt;&lt;td&gt;User's total store credit after the event.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;authorization_code&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;no&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Code linking authorize, capture and void events.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; deleted_at&lt;/td&gt;&lt;td nowrap&gt;datetime&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Soft-delete time; null while active.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;originator_type&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Class of what triggered the event.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; originator_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Payment or user that triggered the event.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;created_at&lt;/td&gt;&lt;td nowrap&gt;datetime&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Row creation time.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;updated_at&lt;/td&gt;&lt;td nowrap&gt;datetime&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Last update time.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;amount_remaining&lt;/td&gt;&lt;td nowrap&gt;decimal(8,2)&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Credit remaining after the event.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; store_credit_reason_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;References the store credit reason.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;customer_metadata&lt;/td&gt;&lt;td nowrap&gt;jsonb&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;{}&lt;/td&gt;&lt;td&gt;JSON metadata set through the storefront or API.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;admin_metadata&lt;/td&gt;&lt;td nowrap&gt;jsonb&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/