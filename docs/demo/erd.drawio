;font-weight:bold&quot;&gt;PII&lt;/span&gt; tracking&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Carrier tracking number.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; number&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Human-readable unique identifier shown to customers and staff.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;cost&lt;/td&gt;&lt;td nowrap&gt;decimal(10,2)&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;0.0&lt;/td&gt;&lt;td&gt;Selected shipping rate cost.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;shipped_at&lt;/td&gt;&lt;td nowrap&gt;datetime&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;When the package left the stock location.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; &lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; order_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;References the order.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#7c5cc4;font-size:9px;font-weight:bold&quot;&gt;ENUM&lt;/span&gt; state&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Current state of the state machine.&lt;br&gt;pending — Awaiting payment or stock&lt;br&gt;ready — Can be shipped&lt;br&gt;shipped&lt;br&gt;canceled&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;created_at&lt;/td&gt;&lt;td nowrap&gt;datetime&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Row creation time.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;updated_at&lt;/td&gt;&lt;td nowrap&gt;datetime&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Last update time.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; &lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; stock_location_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Location the shipment ships from.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;adjustment_total&lt;/td&gt;&lt;td nowrap&gt;decimal(10,2)&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;0.0&lt;/td&gt;&lt;td&gt;Sum of all adjustments.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;additional_tax_total&lt;/td&gt;&lt;td nowrap&gt;decimal(10,2)&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;0.0&lt;/td&gt;&lt;td&gt;Tax added on top of the price.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;promo_total&lt;/td&gt;&lt;td nowrap&gt;decimal(10,2)&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;0.0&lt;/td&gt;&lt;td&gt;Sum of promotion adjustments.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;included_tax_total&lt;/td&gt;&lt;td nowrap&gt;decimal(10,2)&lt;/td&gt;&lt;td nowrap&gt;no&lt;/td&gt;&lt;td nowrap&gt;0.0&lt;/td&gt;&lt;td&gt;Tax already included in the price.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;customer_metadata&lt;/td&gt;&lt;td nowrap&gt;jsonb&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;{}&lt;/td&gt;&lt;td&gt;JSON metadata set through the storefront or API.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;admin_metadata&lt;/td&gt;&lt;td nowrap&gt;jsonb&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;{}&lt;/td&gt;&lt;td&gt;JSON metadata set by admins only.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p style=&quot;margin:8px 0 2px&quot;&gt;&lt;b&gt;Indexes&lt;/b&gt;&lt;/p&gt;index_shipments_on_number: number&lt;br&gt;index_spree_shipments_on_order_id: order_id&lt;br&gt;index_spree_shipments_on_stock_location_id: stock_location_id&lt;br&gt;&lt;p style=&quot;margin:8px 0 2px&quot;&gt;&lt;b&gt;References&lt;/b&gt;&lt;/p&gt;order_id → solidus.public.spree_orders.id&lt;br&gt;stock_location_id → solidus.public.spree_stock_locations.id&lt;br&gt;&lt;p style=&quot;margin:8px 0 2px&quot;&gt;&lt;b&gt;Referenced by&lt;/b&gt;&lt;/p&gt;solidus.public.spree_cartons.imported_from_shipment_id → id&lt;br&gt;solidus.public.spree_inventory_units.shipment_id → id&lt;br&gt;solidus.public.spree_shipping_rates.shipment_id → id&lt;br&gt;solidus.public.spree_adjustments.adjustable_id (polymorphic «adjustable»)&lt;br&gt;solidus.public.spree_state_changes.stateful_id (polymorphic «stateful»)&lt;br&gt;solidus.public.spree_stock_movements.originator_id (polymorphic «originator»)&lt;br&gt;"><mxCell style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;columnLines=0;resizeLast=1;html=1;whiteSpace=nowrap;overflow=hidden;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#172033;fillColor=#e6f7d9;swimlaneFillColor=#ffffff;strokeColor=#b8c2d0;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Awght%40400%3B700" vertex="1" parent="g|solidus/Shipping"><mxGeometry x="35" y="1405" width="240" height="350" as="geometry"/></mxCell></UserObject>
