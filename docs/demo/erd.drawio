        <UserObject id="n|solidus.public.spree_tax_rates" label="&lt;span style=&quot;font-kerning: none; font-variant-ligatures: none; font-feature-settings: 'kern' 0, 'liga' 0, 'calt' 0;&quot;&gt;&lt;img src=&quot;data:image/svg+xml;base64,&quot; width=&quot;12&quot; height=&quot;12&quot; style=&quot;vertical-align:middle;margin-right:3px&quot;&gt;spree_tax_rates&lt;/span&gt;" table="solidus.public.spree_tax_rates" domain="Tax &amp; Calculators" description="A tax rate applied in a zone for tax categories, included in or added to the price." central="yes" indexes="index_spree_tax_rates_on_deleted_at: deleted_at&#10;index_spree_tax_rates_on_zone_id: zone_id" note="&lt;p style=&quot;margin:0 0 4px&quot;&gt;&lt;b&gt;solidus.public.spree_tax_rates&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 0 2px&quot;&gt;A tax rate applied in a zone for tax categories, included in or added to the price.&lt;/p&gt;&lt;table cellpadding=&quot;2&quot; style=&quot;border-collapse:collapse;width:100%;overflow-wrap:anywhere;font-size:11px;margin-top:6px&quot;&gt;&lt;tr align=&quot;left&quot; style=&quot;color:#7a8597;white-space:nowrap&quot;&gt;&lt;th&gt;Column&lt;/th&gt;&lt;th&gt;Type&lt;/th&gt;&lt;th&gt;Null&lt;/th&gt;&lt;th&gt;Default&lt;/th&gt;&lt;th&gt;Comment&lt;/th&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#c98a04;font-size:9px;font-weight:bold&quot;&gt;PK&lt;/span&gt; &lt;b&gt;id&lt;/b&gt;&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Surrogate key.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;amount&lt;/td&gt;&lt;td nowrap&gt;decimal(8,5)&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Rate as a fraction, e.g. 0.2.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; &lt;span style=&quot;color:#1f9d8f;fon