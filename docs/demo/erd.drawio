yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Last update time.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; &lt;span style=&quot;color:#c53030;font-size:9px;font-weight:bold&quot;&gt;PII&lt;/span&gt; name&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Full name of the recipient.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#c53030;font-size:9px;font-weight:bold&quot;&gt;PII&lt;/span&gt; vat_id&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;VAT identification number.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#c53030;font-size:9px;font-weight:bold&quot;&gt;PII&lt;/span&gt; email&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Email address.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#7c5cc4;font-size:9px;font-weight:bold&quot;&gt;ENUM&lt;/span&gt; reverse_charge_status&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;no&lt;/td&gt;&lt;td nowrap&gt;0&lt;/td&gt;&lt;td&gt;Enum values: 0 = disabled, 1 = enabled, 2 = not_validated&lt;br&gt;0 — Reverse charge disabled&lt;br&gt;1 — Reverse charge enabled&lt;br&gt;2 — VAT id not validated yet&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p style=&quot;margin:8px 0 2px&quot;&gt;&lt;b&gt;Indexes&lt;/b&gt;&lt;/p&gt;index_spree_addresses_on_country_id: country_id&lt;br&gt;index_addresses_on_firstname: firstname&lt;br&gt;index_addresses_on_lastname: lastname&lt;br&gt;name&lt;br&gt;index_spree_addresses_on_state_id: state_id&lt;br&gt;&lt;p style=&quot;margin:8px 0 2px&quot;&gt;&lt;b&gt;References&lt;/b&gt;&lt;/p&gt;country_id → solidus.public.spree_countries.id&lt;br&gt;state_id → solidus.public.spree_states.id&lt;br&gt;&lt;p style=&quot;margin:8px 0 2px&quot;&gt;&lt;b&gt;Referenced by&lt;/b&gt;&lt;/p&gt;solidus.public.spree_cartons.address_id → id&lt;br&gt;solidus.public.spree_credit_cards.address_id → id&lt;br&gt;solidus.public.spree_orders.bill_address_id → id&lt;br&gt;solidus.public.spree_orders.ship_address_id → id&lt;br&gt;solidus.public.spree_stores.address_id → id&lt;br&gt;solidus.public.spree_user_addresses.address_id → id&lt;br&gt;solidus.public.spree_users.bill_address_id → id&lt;br&gt;solidus.public.spree_users.ship_address_id → id&lt;br&gt;"><mxCell style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;columnLines=0;resizeLast=1;html=1;whiteSpace=nowrap;overflow=hidden;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#172033;fillColor=#a8f0c0;swimlaneFillColor=#ffffff;strokeColor=#3fa662;strokeWidth=2;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Awght%40400%3B700" vertex="1" parent="g|solidus/Geography"><mxGeometry x="35" y="495" width="230" height="410" as="geometry"/></mxCell></UserObject>
