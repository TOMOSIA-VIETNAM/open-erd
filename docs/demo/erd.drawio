&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Surrogate key.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; source_type&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Class of what created the adjustment.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; &lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; source_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Tax rate, promotion action, benefit or unit cancel that created it.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; adjustable_type&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Class of the adjusted record.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; &lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; adjustable_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;no&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Order, line item or shipment adjusted.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;amount&lt;/td&gt;&lt;td nowrap&gt;decimal(10,2)&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Monetary amount.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;label&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Text shown for the adjustment.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;created_at&lt;/td&gt;&lt;td nowrap&gt;datetime&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Row creation time.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;updated_at&lt;/td&gt;&lt;td nowrap&gt;datetime&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Last update time.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; &lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; order_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;no&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Order the adjustment belongs to.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;included&lt;/td&gt;&lt;td nowrap&gt;boolean&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;false&lt;/td&gt;&lt;td&gt;True when the amount is already part of the price (VAT).&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; adjustment_reason_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Reason of a manual adjustment.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;finalized&lt;/td&gt;&lt;td nowrap&gt;boolean&lt;/td&gt;&lt;td nowrap&gt;no&lt;/td&gt;&lt;td nowrap&gt;false&lt;/td&gt;&lt;td&gt;Frozen; no longer recalculated.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; &lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; promotion_code_id&lt;/td&gt