        <UserObject id="n|solidus.public.spree_payments" label="&lt;span style=&quot;font-kerning: none; font-variant-ligatures: none; font-feature-settings: 'kern' 0, 'liga' 0, 'calt' 0;&quot;&gt;&lt;img src=&quot;data:image/svg+xml;base64,&quot; width=&quot;12&quot; height=&quot;12&quot; style=&quot;vertical-align:middle;margin-right:3px&quot;&gt;spree_payments&lt;/span&gt;" table="solidus.public.spree_payments" domain="Payments" description="Money taken on an order through a payment method and source, tracked through a state machine." central="yes" indexes="number unique&#10;index_spree_payments_on_order_id: order_id&#10;index_spree_payments_on_payment_method_id: payment_method_id&#10;index_spree_payments_on_source_id_and_source_type: source_id, source_type" note="&lt;p style=&quot;margin:0 0 4px&quot;&gt;&lt;b&gt;solidus.public.spree_payments&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 0 2px&quot;&gt;Money taken on an order through a payment method and source, tracked through a state machine.&lt;/p&gt;&lt;table cellpadding=&quot;2&quot; style=&quot;border-collapse:collapse;width:100%;overflow-wrap:anywhere;font-size:11px;margin-top:6px&quot;&gt;&lt;tr align=&quot;left&quot; style=&quot;color:#7a8597;white-space:nowrap&quot;&gt;&lt;th&gt;Column&lt;/th&gt;&lt;th&gt;Type&lt;/th&gt;&lt;th&gt;Null&lt;/th&gt;&lt;th&gt;Default&lt;/th&gt;&lt;th&gt;Comment&lt;/th&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#c98a04;font-size:9px;font-weight:bold&quot;&gt;PK&lt;/span&gt; &lt;b&gt;id&lt;/b&gt;&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Surrogate key.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;amount&lt;/td&gt;&lt;td nowrap&gt;decimal(10,2)&lt;/td&gt;&lt;td nowrap&gt;no&lt;/td&gt;&lt;td nowrap&gt;0.0&lt;/td&gt;&lt;td&gt;Amount to charge.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; &lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; order_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;References the order.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; source_type&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Class of the payment source.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; &lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; source_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Credit card or store credit used.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; &lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; payment_method_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;References the payment method.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#7c5cc4;font-size:9px;font-weight:bold&quot;&gt;ENUM&lt;/span&gt; state&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Current state of the state machine.&lt;br&gt;checkout — Created during checkout&lt;br&gt;pending — Authorized, not captured&lt;br&gt;processing — Being processed by the gateway&lt;br&gt;completed — Captured&lt;br&gt;failed — Gateway declined&lt;br&gt;void — Voided&lt;br&gt;invalid — Invalidated before processing&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;response_code&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Gateway transaction reference.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;avs_response&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Address verification result from the gateway.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;created_at&lt;/td&gt;&lt;td nowrap&gt;datetime&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Row creation time.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;updated_at&lt;/td&gt;&lt;td nowrap&gt;datetime&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Last update time.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; number&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Human-readable unique identifier shown to customers and staff.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;cvv_response_code&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;CVV check code from the gateway.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;cvv_response_message&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;CVV check message from the gateway.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;customer_metadata&lt;/td&gt;&lt;td nowrap&gt;jsonb&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;{}&lt;/td&gt;&lt;td&gt;JSON metadata set through the storefront or API.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;admin_metadata&lt;/td&gt;&lt;td nowrap&gt;jsonb&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;{}&lt;/td&gt;&lt;td&gt;JSON metadata set by admins only.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p style=&quot;margin:8px 0 2px&quot;&gt;&lt;b&gt;Indexes&lt;/b&gt;&lt;/p&gt;number (unique)&lt;br&gt;index_spree_payments_on_order_id: order_id&lt;br&gt;index_spree_payments_on_payment_method_id: payment_method_id&lt;br&gt;index_spree_payments_on_source_id_and_source_type: source_id, source_type&lt;br&gt;&lt;p style=&quot;margin:8px 0 2px&quot;&gt;&lt;b&gt;References&lt;/b&gt;&lt;/p&gt;order_id → solidus.public.spree_orders.id&lt;br&gt;payment_method_id → solidus.public.spree_payment_methods.id&lt;br&gt;source_id → solidus.public.spree_credit_cards, solidus.public.spree_store_credits (polymorphic «source»)&lt;br&gt;&lt;p style=&quot;margin:8px 0 2px&quot;&gt;&lt;b&gt;Referenced by&lt;/b&gt;&lt;/p&gt;solidus.public.spree_payment_capture_events.payment_id → id&lt;br&gt;solidus.public.spree_refunds.payment_id → id&lt;br&gt;solidus.public.spree_log_entries.source_id (polymorphic «source»)&lt;br&gt;solidus.public.spree_state_changes.stateful_id (polymorphic «stateful»)&lt;br&gt;solidus.public.spree_store_credit_events.originator_id (polymorphic «originator»)&lt;br&gt;"><mxCell style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;columnLines=0;resizeLast=1;html=1;whiteSpace=nowrap;overflow=hidden;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#172033;fillColor=#f0a8c0;swimlaneFillColor=#ffffff;strokeColor=#a63f62;strokeWidth=2;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Awght%40400%3B700" vertex="1" parent="g|solidus/Payments"><mxGeometry x="885" y="1095" width="230" height="350" as="geometry"/></mxCell></UserObject>
