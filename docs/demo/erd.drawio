        <UserObject id="n|solidus.public.spree_return_items" label="&lt;span style=&quot;font-kerning: none; font-variant-ligatures: none; font-feature-settings: 'kern' 0, 'liga' 0, 'calt' 0;&quot;&gt;&lt;img src=&quot;data:image/svg+xml;base64,&quot; width=&quot;12&quot; height=&quot;12&quot; style=&quot;vertical-align:middle;margin-right:3px&quot;&gt;spree_return_items&lt;/span&gt;" table="solidus.public.spree_return_items" domain="Returns" description="An inventory unit being returned, with reception and acceptance status and amount to reimburse." central="yes" indexes="index_return_items_on_customer_return_id: customer_return_id&#10;index_spree_return_items_on_exchange_inventory_unit_id: exchange_inventory_unit_id" note="&lt;p style=&quot;margin:0 0 4px&quot;&gt;&lt;b&gt;solidus.public.spree_return_items&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 0 2px&quot;&gt;An inventory unit being returned, with reception and acceptance status and amount to reimburse.&lt;/p&gt;&lt;table cellpadding=&quot;2&quot; style=&quot;border-collapse:collapse;width:100%;overflow-wrap:anywhere;font-size:11px;margin-top:6px&quot;&gt;&lt;tr align=&quot;left&quot; style=&quot;color:#7a8597;white-space:nowrap&quot;&gt;&lt;th&gt;Column&lt;/th&gt;&lt;th&gt;Type&lt;/th&gt;&lt;th&gt;Null&lt;/th&gt;&lt;th&gt;Default&lt;/th&gt;&lt;th&gt;Comment&lt;/th&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#c98a04;font-size:9px;font-weight:bold&quot;&gt;PK&lt;/span&gt; &lt;b&gt;id&lt;/b&gt;&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Surrogate key.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; return_authorization_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;References the return authorization.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; inventory_unit_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;References the inventory unit.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; exchange_variant_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Variant sent as exchange.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;created_at&lt;/td&gt;&lt;td nowrap&gt;datetime&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Row creation time.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;updated_at&lt;/td&gt;&lt;td nowrap&gt;datetime&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Last update time.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;amount&lt;/td&gt;&lt;td nowrap&gt;decimal(12,4)&lt;/td&gt;&lt;td nowrap&gt;no&lt;/td&gt;&lt;td nowrap&gt;0.0&lt;/td&gt;&lt;td&gt;Amount to reimburse.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;included_tax_total&lt;/td&gt;&lt;td nowrap&gt;decimal(12,4)&lt;/td&gt;&lt;td nowrap&gt;no&lt;/td&gt;&lt;td nowrap&gt;0.0&lt;/td&gt;&lt;td&gt;Tax already included in the price.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;additional_tax_total&lt;/td&gt;&lt;td nowrap&gt;decimal(12,4)&lt;/td&gt;&lt;td nowrap&gt;no&lt;/td&gt;&lt;td nowrap&gt;0.0&lt;/td&gt;&lt;td&gt;Tax added on top of the price.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#7c5cc4;font-size:9px;font-weight:bold&quot;&gt;ENUM&lt;/span&gt; reception_status&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Whether and how the item came back.&lt;br&gt;awaiting — Not received yet&lt;br&gt;received — Received at the stock location&lt;br&gt;cancelled — Return canceled&lt;br&gt;given_to_customer — Kept by the customer&lt;br&gt;lost_in_transit — Lost on the way back&lt;br&gt;shipped_wrong_item — Wrong item sent back&lt;br&gt;short_shipped — Never shipped to the customer&lt;br&gt;in_transit — On the way back&lt;br&gt;expired — Return window expired&lt;br&gt;unexchanged — Exchange reverted&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#7c5cc4;font-size:9px;font-weight:bold&quot;&gt;ENUM&lt;/span&gt; acceptance_status&lt;/td&gt;&lt;td nowrap&gt;string&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Whether the return is accepted.&lt;br&gt;pending — Not evaluated&lt;br&gt;accepted — Eligible for reimbursement&lt;br&gt;rejected — Not eligible&lt;br&gt;manual_intervention_required — Needs a staff decision&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; &lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; customer_return_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;References the customer return.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; reimbursement_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;References the reimbursement.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; &lt;span style=&quot;color:#1f9d8f;font-size:9px;font-weight:bold&quot;&gt;IX&lt;/span&gt; exchange_inventory_unit_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Inventory unit shipped as exchange.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;acceptance_status_errors&lt;/td&gt;&lt;td nowrap&gt;text&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Serialized reasons for rejection.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; preferred_reimbursement_type_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Reimbursement type the customer prefers.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; override_reimbursement_type_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;Reimbursement type forced by an admin.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;resellable&lt;/td&gt;&lt;td nowrap&gt;boolean&lt;/td&gt;&lt;td nowrap&gt;no&lt;/td&gt;&lt;td nowrap&gt;true&lt;/td&gt;&lt;td&gt;Returned item can be restocked.&lt;/td&gt;&lt;/tr&gt;&lt;tr valign=&quot;top&quot;&gt;&lt;td nowrap&gt;&lt;span style=&quot;color:#2f6fd6;font-size:9px;font-weight:bold&quot;&gt;FK&lt;/span&gt; return_reason_id&lt;/td&gt;&lt;td nowrap&gt;integer&lt;/td&gt;&lt;td nowrap&gt;yes&lt;/td&gt;&lt;td nowrap&gt;&lt;/td&gt;&lt;td&gt;References the return reason.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p style=&quot;margin:8px 0 2px&quot;&gt;&lt;b&gt;Indexes&lt;/b&gt;&lt;/p&gt;index_return_items_on_customer_return_id: customer_return_id&lt;br&gt;index_spree_return_items_on_exchange_inventory_unit_id: exchange_inventory_unit_id&lt;br&gt;&lt;p style=&quot;margin:8px 0 2px&quot;&gt;&lt;b&gt;References&lt;/b&gt;&lt;/p&gt;customer_return_id → solidus.public.spree_customer_returns.id&lt;br&gt;exchange_inventory_unit_id → solidus.public.spree_inventory_units.id&lt;br&gt;exchange_variant_id → solidus.public.spree_variants.id&lt;br&gt;inventory_unit_id → solidus.public.spree_inventory_units.id&lt;br&gt;override_reimbursement_type_id → solidus.public.spree_reimbursement_types.id&lt;br&gt;preferred_reimbursement_type_id → solidus.public.spree_reimbursement_types.id&lt;br&gt;reimbursement_id → solidus.public.spree_reimbursements.id&lt;br&gt;return_authorization_id → solidus.public.spree_return_authorizations.id&lt;br&gt;return_reason_id → solidus.public.spree_return_reasons.id&lt;br&gt;"><mxCell style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;columnLines=0;resizeLast=1;html=1;whiteSpace=nowrap;overflow=hidden;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#172033;fillColor=#b4a8f0;swimlaneFillColor=#ffffff;strokeColor=#503fa6;strokeWidth=2;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%3Awght%40400%3B700" vertex="1" parent="g|solidus/Returns"><mxGeometry x="535" y="275" width="290" height="410" as="geometry"/></mxCell></UserObject>
